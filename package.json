{
  "name": "patent-intelligence-workbench",
  "private": true,
  "version": "0.6.0",
  "description": "Local patent retrieval and LLM extraction experiment workbench",
  "type": "module",
  "scripts": {
    "start": "node --use-env-proxy src/server.js",
    "start:edge": "node --use-env-proxy scripts/start-edge.js",
    "test": "node --test",
    "test:public": "node scripts/run-public-tests.js",
    "test:local": "node --test",
    "typecheck": "tsc --noEmit",
    "test:live": "node scripts/verify-live-retrieval.js",
    "test:epo-live": "node scripts/verify-live-epo.js",
    "demo": "node src/run-demo.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cheerio": "1.2.0",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
